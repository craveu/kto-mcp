# KTO (Korea Tourism Organization) public API service key.
# Issue your own key at https://www.data.go.kr/data/15101578/openapi.do
# Required at startup — server fails to boot if missing (REQ-UNW-001).
KTO_SERVICE_KEY=

# Set to "true" if your service key is already URL-encoded (%2B, %2F, etc).
# Default false → the client URL-encodes the raw key.
KTO_SERVICE_KEY_PREENCODED=false

# MCP transport mode. One of: stdio | http-streamable | http-json
MCP_TRANSPORT_MODE=stdio

# HTTP port (used only when MCP_TRANSPORT_MODE is http-streamable or http-json)
MCP_HTTP_PORT=3000
